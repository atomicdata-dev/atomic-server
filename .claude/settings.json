{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/browser/data-browser/scripts/react-compiler-hook.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true
  }
}
