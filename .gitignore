/target
.envrc
.env
# Per-developer overrides. Vite loads `.env.local` in *every* mode, production
# builds included, so a committed one bakes a local machine's URLs into shipped
# bundles. Checked-in defaults belong in `.env.development` (dev-mode only).
.env.local
.env.*.local
trace-*.json
dev-drive-trace-*.json
**/.temp
.DS_Store
artifact
# Store for the e2e server (`browser/e2e/scripts/e2e-server.sh`) — test data
# only, kept out of the dev store on purpose.
/.e2e-store
server/assets_tmp
server/js-build.log
.netlify
scratchpad
.claude
.antigravitycli

