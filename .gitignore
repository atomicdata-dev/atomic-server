/build/
/test_opts
/test_parse
/test_opts.rs
/test_parse.rs
/test_url.rs

# Merge-tool backup files (*.orig, *.rej)
*.orig
*.rej

# Ignore .cargo but not the config.
.cargo/*
!.cargo/config.toml

.bin/
.fastembed_cache

