{
  "name": "@tomic/form-app",
  "version": "0.41.0-beta.0",
  "private": true,
  "description": "Published-form runtime served at /form/:id — a small Vite app with no @tomic/lib or Loro dependency.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "pnpm dev",
    "format-check": "oxfmt -c ../.oxfmtrc.json --check ./src",
    "format": "oxfmt -c ../.oxfmtrc.json ./src",
    "lint": "oxlint -c ../.oxlintrc.json . && pnpm format-check",
    "lint-fix": "oxlint -c ../.oxlintrc.json --fix . && pnpm format",
    "typecheck": "pnpm exec tsc --noEmit"
  },
  "dependencies": {
    "@tomic/form-renderer": "workspace:*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.14"
  }
}
