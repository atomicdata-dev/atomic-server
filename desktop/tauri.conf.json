{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atomic Server",
  "version": "0.41.0-beta.8",
  "identifier": "io.ontola.atomicserver",
  "build": {
    "frontendDist": "../browser/data-browser/dist-tauri",
    "devUrl": "http://localhost:6747",
    "beforeDevCommand": "pnpm -C browser/data-browser dev:tauri",
    "beforeBuildCommand": "pnpm -C browser/data-browser build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "Atomic Server",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: http: https:",
        "media-src": "'self' data: blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' blob: http: https:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT license - joep@ontola.io",
    "category": "DeveloperTool",
    "shortDescription": "Atomic Server is a graph database with an easy to use GUI. Model, share and create Atomic Data.",
    "longDescription": "Atomic Server is a graph database with an easy to use GUI. Model, share and create Atomic Data.",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "",
      "exceptionDomain": "",
      "signingIdentity": "Developer ID Application: Argu B.V. (Q9WPWRTU7G)",
      "entitlements": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "atomic"
          ]
        }
      ],
      "desktop": {
        "schemes": [
          "atomic"
        ]
      }
    }
  }
}
