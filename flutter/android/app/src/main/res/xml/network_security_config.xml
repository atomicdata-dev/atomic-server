<?xml version="1.0" encoding="utf-8"?>
<!-- The embedded renderer's own files are served to the app's web view from
     the loopback address; plain HTTP is allowed there and nowhere else. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
