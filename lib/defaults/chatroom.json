    ],
    "https://atomicdata.dev/properties/requires": [
      "https://atomicdata.dev/properties/parent"
    ],
    "https://atomicdata.dev/properties/shortname": "chat-log"
  },
  {
    "@id": "https://atomicdata.dev/classes/FollowEvent",
