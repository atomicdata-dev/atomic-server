{
  "cases": [
    {
      "name": "shop: every mapping, exact round trip",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Shop",
        "description": "Invoices and customers.",
        "x-atomic-ontology": "shop",
        "$defs": {
          "customer": {
            "type": "object",
            "description": "Someone who pays.",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Full name."
              },
              "email": {
                "type": "string",
                "pattern": "^[^@]+@[^@]+$"
              }
            },
            "required": [
              "name"
            ]
          },
          "invoice": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "pattern": "^INV-[0-9]{4}$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "sent",
                  "paid"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 100000
              },
              "quantity": {
                "type": "integer",
                "minimum": 1,
                "maximum": 99
              },
              "issued": {
                "type": "string",
                "format": "date-time"
              },
              "due": {
                "type": "string",
                "format": "date"
              },
              "paid": {
                "type": "boolean"
              },
              "website": {
                "type": "string",
                "format": "uri"
              },
              "notes": {
                "type": "string",
                "x-atomic-datatype": "https://atomicdata.dev/datatypes/markdown"
              },
              "customer": {
                "$ref": "#/$defs/customer",
                "description": "Who is billed."
              },
              "lines": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/line-item"
                },
                "minItems": 1,
                "maxItems": 50
              }
            },
            "required": [
              "number",
              "customer"
            ]
          },
          "line-item": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "price": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "notes": {
                "type": "string",
                "x-atomic-datatype": "https://atomicdata.dev/datatypes/markdown"
              }
            }
          }
        }
      },
      "plan": {
        "shortname": "shop",
        "name": "Shop",
        "description": "Invoices and customers.",
        "classes": [
          {
            "shortname": "customer",
