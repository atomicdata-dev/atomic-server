{
  "schemaVersion": 2,
  "runtime": "wasip2/1",
  "world": "sandboxed-app",
  "name": "caller",
  "namespace": "example",
  "version": "0.1.0",
  "description": "Calls the counter app twice through the host.",
  "uses": ["atomic:example/counter@1", "atomic:example/caller@1"],
  "exports": [
    {
      "interface": "atomic:example/caller@1",
      "function": "bump-twice",
      "description": "Increments a counter twice, by calling atomic:example/counter@1.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "subject": { "type": "string", "description": "The resource to count on." },
          "property": { "type": "string", "description": "The integer property that holds the count." }
        },
        "required": ["subject", "property"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "count": { "type": "integer", "description": "The count after both increments." }
        },
        "required": ["count"],
        "additionalProperties": false
      },
      "effect": "write"
    },
    {
      "interface": "atomic:example/caller@1",
      "function": "recurse",
      "description": "Calls itself until n reaches limit. Shows the host's call depth limit.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "n": { "type": "integer", "description": "The current depth." },
          "limit": { "type": "integer", "description": "The depth to stop at." }
        },
        "required": ["n", "limit"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "depth": { "type": "integer", "description": "The depth reached." }
        },
        "required": ["depth"],
        "additionalProperties": false
      },
      "effect": "read"
    }
  ]
}
